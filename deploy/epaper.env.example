# Per-device settings for one photo frame. Rendered to /etc/epaper/epaper.env by
# deploy/install.sh. Lives outside the git checkout so a deploy cannot delete it.
#
# systemd reads this file literally: no quotes needed, no shell expansion, no $VARS.

# A human name for this frame, logged at startup.
EPAPER_FRAME_NAME=living-room

# Where photos and display state live. Must match "remote_photos_path" in the
# sender config for this frame (that path is this one plus /photos).
EPAPER_DATA=/home/CHANGE_ME/epaper-data

# Quiet hours, local time, 24h. 0 and 8 means paused 00:00-07:59.
EPAPER_PAUSE_FROM_HOUR=0
EPAPER_PAUSE_UNTIL_HOUR=8

# Seconds per photo.
EPAPER_DISPLAY_SECONDS=180
