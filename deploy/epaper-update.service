[Unit]
Description=Pull photo frame updates from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__EPAPER_USER__
WorkingDirectory=__EPAPER_REPO__
EnvironmentFile=-/etc/epaper/epaper.env
ExecStart=__EPAPER_REPO__/deploy/pull-deploy.sh

# Drop any log below a warning
LogLevelMax=notice
